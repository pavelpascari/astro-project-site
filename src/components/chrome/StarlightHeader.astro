---
// OWNER: landing agent. Starlight's Header override: the shared site header, with Starlight's own search
// and theme select slotted in so both keep working. The mobile sidebar toggle is rendered by Starlight's
// PageFrame next to the header and is untouched.
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
// Starlight publishes no types for its virtual config module; we read two fields from it.
// @ts-expect-error virtual module without type declarations
import userConfig from 'virtual:starlight/user-config';
import SiteHeader from './SiteHeader.astro';
import { themeOverrideCss } from '../../lib/theme';

// Same rule as Starlight's default header: render search when Pagefind is on or Search is overridden.
const config = userConfig as { pagefind: unknown; components: { Search: string } };
const showSearch =
  !!config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const themeCss = themeOverrideCss();
---

{themeCss && <style is:inline set:html={themeCss} />}
<SiteHeader menuStyle="section">
  {showSearch && <Search slot="search" />}
  <ThemeSelect slot="theme" />
</SiteHeader>
