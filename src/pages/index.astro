---
// OWNER: landing agent.
// The landing page, composed from the section components in src/components/landing/ and the `landing`
// content in site.config.ts. Reorder, remove or add sections freely; each one stands alone.
import { Code } from 'astro:components';
import site from '../../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Section from '../components/landing/Section.astro';
import Features from '../components/landing/Features.astro';
import Steps from '../components/landing/Steps.astro';
import GalleryStrip from '../components/landing/GalleryStrip.astro';
import CallToAction from '../components/landing/CallToAction.astro';

const landing = site.landing ?? {};
const hero = landing.hero ?? {};
const demo = `import { hello } from 'example-project';

document.querySelector('output').textContent = hello('world');`;
---

<BaseLayout>
  <Hero
    title={hero.title ?? site.name}
    lead={hero.lead ?? site.tagline}
    primary={hero.primary}
    secondary={hero.secondary}
    install={site.install}
  >
    {/* The `live` slot spans the full width: put a demo canvas or custom element here. */}
    <div slot="live" class="demo site-container">
      <Code code={demo} lang="js" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
      <p class="demo-output">Output: <output>Hello, world</output></p>
    </div>
  </Hero>

  {
    landing.features && landing.features.length > 0 && (
      <Section id="features" title="Why it exists" intro="The short version, for people deciding whether to read on.">
        <Features items={landing.features} />
      </Section>
    )
  }

  {
    landing.gallery?.limit !== 0 && (
      <GalleryStrip title={landing.gallery?.title} limit={landing.gallery?.limit} />
    )
  }

  {
    landing.steps && landing.steps.length > 0 && (
      <Section id="how-it-works" title="How it works">
        <Steps items={landing.steps} />
      </Section>
    )
  }

  {landing.cta && <CallToAction {...landing.cta} />}
</BaseLayout>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    max-width: 44rem;
  }
  .demo-output {
    margin: 0;
    color: var(--site-muted);
    font-size: 0.9375rem;
  }
  .demo-output output {
    font-family: var(--site-font-mono);
    color: var(--site-text);
  }
</style>
