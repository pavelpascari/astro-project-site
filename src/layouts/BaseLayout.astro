---
// Page frame for everything outside the docs: head metadata, the shared header and footer, base styles.
// The header bar matches Starlight's so moving between the landing page and the docs feels like one site.
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHead from '../components/chrome/SiteHead.astro';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import ThemeSelect from '../components/chrome/ThemeSelect.astro';

interface Props {
  title?: string;
  description?: string;
  /** Social image for this page (defaults to the `ogImageFor()` hook). */
  image?: string;
  noindex?: boolean;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <SiteHead {...props}><slot name="head" /></SiteHead>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-bar">
      <div class="site-bar-inner">
        <SiteHeader>
          <ThemeSelect slot="theme" id="site-theme" />
          <ThemeSelect slot="theme-menu" id="site-theme-menu" />
        </SiteHeader>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
