---
// Docs helper: shows a component rendered for real (the slot), framed like a <Live> preview, above the .astro code
// that produces it. <Live> runs HTML in the browser; Astro components render at build time, so component demos
// use this instead.
//
// The landing and gallery components style their buttons and containers with utility classes from the package's
// base.css, which only BaseLayout pages load (not Starlight docs pages). The few rules they need are repeated
// here, scoped to the preview.
import { Code } from '@astrojs/starlight/components';

interface Props {
  code: string;
  title?: string;
  lang?: string;
  caption?: string;
}
const { code, title = 'src/pages/example.astro', lang = 'astro', caption } = Astro.props;
---

<figure class="rendered">
  <div class="rendered__preview not-content">
    <slot />
  </div>
  <Code code={code} lang={lang} title={title} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .rendered {
    margin: 1.5rem 0 0;
  }
  .rendered__preview {
    padding: 1rem 0;
    border: 1px solid var(--sl-color-hairline);
    border-bottom: 0;
    border-radius: 0.5rem 0.5rem 0 0;
    background: var(--site-bg);
    color: var(--site-text);
    font-family: var(--site-font-body);
    line-height: 1.6;
    overflow: hidden;
  }
  .rendered :global(.expressive-code) {
    margin: 0;
  }
  .rendered :global(.expressive-code .frame),
  .rendered :global(.expressive-code .frame pre) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  /* From astro-project-site's base.css (BaseLayout pages only), scoped to the preview. */
  .rendered__preview :global(h1),
  .rendered__preview :global(h2),
  .rendered__preview :global(h3),
  .rendered__preview :global(h4) {
    font-family: var(--site-font-heading);
    line-height: 1.2;
    margin: 0 0 0.5em;
    text-wrap: balance;
  }
  .rendered__preview :global(p) {
    margin: 0 0 1em;
  }
  .rendered__preview :global(.site-container) {
    width: 100%;
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--site-space);
  }
  .rendered__preview :global(.site-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-sm);
    font: inherit;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    color: var(--site-text);
    background: var(--site-bg);
  }
  .rendered__preview :global(.site-btn--primary) {
    border-color: var(--site-accent);
    background: var(--site-accent);
    color: var(--site-on-accent);
  }
  .rendered__preview :global(.site-visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .rendered__preview :global(.astro-code) {
    margin: 0;
    padding: 1rem 1.125rem;
    border-radius: var(--site-radius-sm);
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-x: auto;
    border: 1px solid var(--site-border);
  }
  :global(:root[data-theme='dark']) .rendered__preview :global(.astro-code),
  :global(:root[data-theme='dark']) .rendered__preview :global(.astro-code span) {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
  }
  :global(:root[data-theme='light']) .rendered__preview :global(.astro-code),
  :global(:root[data-theme='light']) .rendered__preview :global(.astro-code span) {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }
</style>
