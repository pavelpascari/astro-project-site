---
// Starlight's Sidebar override: Starlight's own sidebar, with a filter box above it when the sidebar is long
// (more than COLLAPSE_ABOVE links, the size at which groups start collapsed). Typing narrows the tree to the
// matching pages and opens their groups; clearing it restores the tree as it was. `/` focuses it.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { COLLAPSE_ABOVE } from '../lib/sidebar.mjs';

type Entry = { type: 'link' } | { type: 'group'; entries: Entry[] };
const count = (entries: Entry[]): number => entries.reduce((n, e) => n + (e.type === 'link' ? 1 : count(e.entries)), 0);
const showFilter = count(Astro.locals.starlightRoute.sidebar as Entry[]) > COLLAPSE_ABOVE;
---

{
  showFilter && (
    <sidebar-filter class="sidebar-filter">
      <label>
        <span class="site-sr-only">Filter the navigation</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 6h16M7 12h10M10 18h4" />
        </svg>
        <input type="search" placeholder="Filter" autocomplete="off" spellcheck="false" aria-keyshortcuts="/" />
        <kbd aria-hidden="true">/</kbd>
      </label>
      <p class="site-sr-only" role="status" aria-live="polite" />
    </sidebar-filter>
  )
}
<Default><slot /></Default>

<script>
  class SidebarFilter extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input')!;
      const status = this.querySelector('[role="status"]')!;
      const root = this.closest('.sidebar-content') ?? document;
      const tree = root.querySelector<HTMLElement>('ul.top-level');
      if (!tree) return;
      const items = [...tree.querySelectorAll<HTMLLIElement>('li')];
      const details = [...tree.querySelectorAll('details')];
      let saved: boolean[] | null = null;
      let timer: number | undefined;

      const apply = () => {
        const q = input.value.trim().toLowerCase();
        if (!q) {
          items.forEach((li) => (li.hidden = false));
          if (saved) details.forEach((d, i) => (d.open = saved![i]));
          saved = null;
          status.textContent = '';
          return;
        }
        saved ??= details.map((d) => d.open);
        let matches = 0;
        // Leaves first: a link matches on its text; a group shows when its label or anything inside matches.
        for (const li of [...items].reverse()) {
          const link = li.querySelector(':scope > a');
          const group = li.querySelector(':scope > details');
          if (link) {
            const hit = (link.textContent ?? '').toLowerCase().includes(q);
            li.hidden = !hit;
            if (hit) matches++;
          } else if (group) {
            const label = (group.querySelector(':scope > summary')?.textContent ?? '').toLowerCase();
            const inner = [...group.querySelectorAll(':scope > ul > li')].some((c) => !(c as HTMLElement).hidden);
            if (label.includes(q) && !inner) group.querySelectorAll<HTMLLIElement>('li').forEach((c) => (c.hidden = false));
            li.hidden = !(inner || label.includes(q));
            (group as HTMLDetailsElement).open = !li.hidden;
          }
        }
        clearTimeout(timer);
        timer = window.setTimeout(() => (status.textContent = matches ? `${matches} pages match` : 'No pages match'), 400);
      };
      input.addEventListener('input', apply);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && input.value) {
          e.stopPropagation();
          input.value = '';
          apply();
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable]') || !input.offsetParent) return;
        e.preventDefault();
        input.focus();
      });
    }
  }
  if (!customElements.get('sidebar-filter')) customElements.define('sidebar-filter', SidebarFilter);
</script>

<style>
  .sidebar-filter {
    display: block;
    margin-bottom: 1rem;
  }
  label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding-inline: 0.625rem;
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-sm);
    background: var(--site-bg);
    color: var(--sl-color-gray-3);
  }
  label:focus-within {
    border-color: var(--site-accent);
    outline: 2px solid color-mix(in oklab, var(--site-focus) 40%, transparent);
    outline-offset: 0;
  }
  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    outline: none;
  }
  input::placeholder {
    color: var(--sl-color-gray-3);
  }
  kbd {
    padding: 0 0.375rem;
    border: 1px solid var(--site-border);
    border-radius: 0.25rem;
    font-family: var(--site-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.4;
  }
  @media (pointer: coarse) {
    label {
      height: 2.75rem;
    }
    kbd {
      display: none;
    }
  }
  .site-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
