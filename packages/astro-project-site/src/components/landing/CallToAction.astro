---
// The closing call to action.
import '../../styles/components.css';
import type { LinkAction } from '../../index';

interface Props {
  title: string;
  body?: string;
  primary?: LinkAction;
  secondary?: LinkAction;
}
const { title, body, primary, secondary } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="site-container">
    <div class="panel">
      <h2 id="cta-title">{title}</h2>
      {body && <p>{body}</p>}
      <div class="actions">
        {
          primary && (
            <a class="site-btn site-btn--primary" href={primary.href}>
              {primary.label}
            </a>
          )
        }
        {
          secondary && (
            <a class="site-btn" href={secondary.href}>
              {secondary.label}
            </a>
          )
        }
      </div>
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: calc(var(--site-space) * 4);
  }
  .panel {
    padding: calc(var(--site-space) * 3) calc(var(--site-space) * 1.5);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius);
    background: var(--site-accent-soft);
    text-align: center;
  }
  h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.125rem);
  }
  p {
    color: var(--site-muted);
    font-size: 1.125rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
