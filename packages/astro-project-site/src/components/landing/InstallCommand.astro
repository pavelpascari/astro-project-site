---
// A shell command with a copy button. The button appears only when the Clipboard API is available.
import '../../styles/components.css';
import { t } from '../../lib/labels';
interface Props {
  command: string;
  /** Accessible name for the command, read before it. */
  label?: string;
}
const { command, label = t('installCommand') } = Astro.props;
// Each word stays whole, so narrow screens wrap between words (never inside `my-site`). textContent is unchanged.
const words = command.split(' ');
---

<div
  class="install"
  role="group"
  aria-label={label}
  data-copy-text={t('copy')}
  data-copied-text={t('copied')}
  data-copied-status={t('copiedToClipboard')}
  data-copy-fallback={t('copyFallback')}
>
  {/* A shell command reads left to right in every language, and is not for browser translation. */}
  <code dir="ltr" translate="no"><span class="prompt" aria-hidden="true">$</span> <span data-command>{words.map((w, i) => <>{i > 0 && ' '}<span class="word">{w}</span></>)}</span></code>
  <button type="button" class="copy" data-copy hidden>
    <span data-copy-label>{t('copy')}</span>
  </button>
  <span class="status site-visually-hidden" role="status" aria-live="polite"></span>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.install')) {
    const button = box.querySelector<HTMLButtonElement>('[data-copy]');
    const label = box.querySelector('[data-copy-label]');
    const status = box.querySelector('[role=status]');
    const text = box.querySelector('[data-command]')?.textContent ?? '';
    if (!button || !navigator.clipboard) continue;
    button.hidden = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        if (label) label.textContent = box.dataset.copiedText ?? '';
        if (status) status.textContent = box.dataset.copiedStatus ?? '';
      } catch {
        if (label) label.textContent = box.dataset.copyFallback ?? '';
      }
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (label) label.textContent = box.dataset.copyText ?? '';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .install {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-sm);
    background: var(--site-code-bg);
    color: var(--site-code-text);
  }
  /* Phones: the box takes the full width, so a long command wraps once instead of into a narrow column. */
  @media (max-width: 30rem) {
    .install {
      display: flex;
      width: 100%;
    }
  }
  code {
    flex: 1 1 auto;
    /* A wrapped command reads from the left, even inside a centred hero. */
    text-align: start;
    font-size: 0.9375rem;
    /* Wrap at spaces on narrow screens instead of hiding the end of the command in a scroll box. */
    white-space: normal;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  /* A word moves to the next line whole when it fits there (never "my-" / "site"); one longer than the line
     (a URL, a github: spec) wraps inside itself instead of pushing the page sideways. */
  .word {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .prompt {
    opacity: 0.55;
    user-select: none;
  }
  .copy {
    flex: none;
    min-height: 2.25rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid color-mix(in oklab, var(--site-code-text) 25%, transparent);
    border-radius: calc(var(--site-radius-sm) - 2px);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .copy[hidden] {
    display: none;
  }
  /* With JavaScript on, the button is about to appear: keep its place so nothing shifts when it does. */
  @media (scripting: enabled) {
    .copy[hidden] {
      display: inline-flex;
      visibility: hidden;
    }
  }
  @media (pointer: coarse) {
    .copy {
      min-height: 2.75rem;
      min-width: 2.75rem;
    }
  }
  .copy:hover {
    background: color-mix(in oklab, var(--site-code-text) 12%, transparent);
  }
</style>
