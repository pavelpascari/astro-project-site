---
// A grid of feature cards. Each card is an <article> with a stable box; linked cards have a real link
// on the title (the whole card is clickable via a stretched hit area, not a wrapper link).
interface Feature {
  title: string;
  body: string;
  href?: string;
}
interface Props {
  items: Feature[];
}
const { items } = Astro.props;
---

<ul class="features" role="list">
  {
    items.map((item) => (
      <li>
        <article class="card" data-linked={item.href ? '' : undefined}>
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <p>{item.body}</p>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--site-space);
  }
  .card {
    position: relative;
    height: 100%;
    padding: calc(var(--site-space) * 1.5);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius);
    background: var(--site-bg);
  }
  h3 {
    font-size: 1.125rem;
    margin-bottom: 0.4rem;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  [data-linked]:hover {
    border-color: var(--site-accent);
  }
  [data-linked]:has(a:focus-visible) {
    outline: 2px solid var(--site-focus);
    outline-offset: 2px;
  }
  h3 a:focus-visible {
    outline: none;
  }
  p {
    margin: 0;
    color: var(--site-muted);
  }
</style>
