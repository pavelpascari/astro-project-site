---
// Kind and tag filters for a GalleryGrid. Hidden until its script runs, so without JavaScript the page
// simply shows every item. The current filter is mirrored in the URL (?kind=…&tag=…) so it can be shared.
interface Props {
  kinds: string[];
  tags: string[];
  /** id of the GalleryGrid to filter. */
  target: string;
  total: number;
}
const { kinds, tags, target, total } = Astro.props;
const showKinds = kinds.length > 1;
const showTags = tags.length > 0;
---

{
  (showKinds || showTags) && (
    <gallery-filters class="filters" data-target={target} data-total={total} hidden>
      {showKinds && (
        <div class="group" role="group" aria-labelledby="filter-kind-label">
          <span class="label" id="filter-kind-label">
            Kind
          </span>
          <button type="button" data-filter="kind" data-value="" aria-pressed="true">
            All
          </button>
          {kinds.map((kind) => (
            <button type="button" data-filter="kind" data-value={kind} aria-pressed="false">
              {kind}
            </button>
          ))}
        </div>
      )}
      {showTags && (
        <div class="group" role="group" aria-labelledby="filter-tag-label">
          <span class="label" id="filter-tag-label">
            Tag
          </span>
          <button type="button" data-filter="tag" data-value="" aria-pressed="true">
            Any
          </button>
          {tags.map((tag) => (
            <button type="button" data-filter="tag" data-value={tag} aria-pressed="false">
              {tag}
            </button>
          ))}
        </div>
      )}
      <p class="status" role="status" aria-live="polite" />
    </gallery-filters>
  )
}

<script>
  class GalleryFilters extends HTMLElement {
    connectedCallback() {
      const grid = document.getElementById(this.dataset.target ?? '');
      if (!grid) return;
      const items = [...grid.querySelectorAll<HTMLElement>(':scope > li')];
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
      const status = this.querySelector('.status');
      const total = items.length;
      const params = new URLSearchParams(location.search);
      const state: Record<string, string> = { kind: params.get('kind') ?? '', tag: params.get('tag') ?? '' };
      // Ignore values from the URL that no button offers.
      for (const key of Object.keys(state)) {
        if (!buttons.some((b) => b.dataset.filter === key && b.dataset.value === state[key])) state[key] = '';
      }

      const render = (announce: boolean) => {
        let shown = 0;
        for (const item of items) {
          const kindOk = !state.kind || item.dataset.kind === state.kind;
          const tagOk = !state.tag || (item.dataset.tags ?? '').split(' ').includes(state.tag);
          item.hidden = !(kindOk && tagOk);
          if (!item.hidden) shown++;
        }
        for (const b of buttons) b.setAttribute('aria-pressed', String(state[b.dataset.filter!] === b.dataset.value));
        if (status) {
          const text = shown === total ? `Showing all ${total}` : `Showing ${shown} of ${total}`;
          // Only announce after user interaction; the initial render just fills the text.
          if (announce || !status.textContent) status.textContent = text;
        }
        const url = new URL(location.href);
        for (const [key, value] of Object.entries(state)) {
          if (value) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        }
        history.replaceState(history.state, '', url);
      };

      this.addEventListener('click', (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>('button[data-filter]');
        if (!button) return;
        state[button.dataset.filter!] = button.dataset.value ?? '';
        render(true);
      });

      this.hidden = false;
      render(false);
    }
  }
  customElements.define('gallery-filters', GalleryFilters);
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-bottom: calc(var(--site-space) * 1.5);
  }
  .filters[hidden] {
    display: none;
  }
  .group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }
  .label {
    margin-inline-end: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--site-muted);
  }
  button {
    min-height: 2.25rem;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--site-border);
    border-radius: 999px;
    background: var(--site-bg);
    color: var(--site-text);
    font: inherit;
    font-size: 0.875rem;
    text-transform: capitalize;
    cursor: pointer;
  }
  button:hover {
    border-color: var(--site-muted);
  }
  button[aria-pressed='true'] {
    border-color: var(--site-accent);
    background: var(--site-accent);
    color: var(--site-on-accent);
  }
  button:focus-visible {
    outline: 2px solid var(--site-focus);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    button {
      min-height: 2.75rem;
    }
  }
  /* Windows high contrast drops the filled background: keep the pressed state visible. */
  @media (forced-colors: active) {
    button[aria-pressed='true'] {
      forced-color-adjust: none;
      border-color: Highlight;
      background: Highlight;
      color: HighlightText;
    }
  }
  .status {
    margin: 0;
    margin-inline-start: auto;
    font-size: 0.875rem;
    color: var(--site-muted);
  }
</style>
