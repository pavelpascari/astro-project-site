---
// Page frame for everything outside the docs: head metadata, the shared header and footer, theme and base styles.
// The header bar matches Starlight's so moving between the landing page and the docs feels like one site.
// The docs search (Starlight's Search, whatever it resolved to) is in the header here too, so search is one
// keystroke away on every page. Here it is a compact button by default (`header.search`), so it does not compete
// with the nav; the docs pages have the full field.
// Use it for a project's own pages too:  import { BaseLayout } from 'astro-project-site/components';
import '../../styles/theme.css';
import '../../styles/base.css';
import '../../styles/components.css';
import 'virtual:astro-project-site/user-css';
import site from 'virtual:astro-project-site/config';
import Footer from 'virtual:astro-project-site/components/Footer';
import Header from 'virtual:astro-project-site/components/Header';
import { Search, showSearch } from 'virtual:astro-project-site/starlight';
import SiteHead from '../chrome/SiteHead.astro';
import ThemeSelect from '../chrome/ThemeSelect.astro';
import { t } from '../../lib/labels';

interface Props {
  title?: string;
  description?: string;
  /** Social image for this page (defaults to the `ogImage` option / `ogImageFor` hook). */
  image?: string;
  noindex?: boolean;
  /** Open Graph type (blog posts are `article`). */
  type?: 'website' | 'article';
  /** Canonical URL when it is not this page's own (e.g. a post first published elsewhere). */
  canonical?: string;
}
const props = Astro.props;
---

<!doctype html>
<html lang={site.lang} dir={site.dir} data-site-page>
  <head>
    <SiteHead {...props}><slot name="head" /></SiteHead>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skipToContent')}</a>
    <header class="site-bar">
      <div class="site-bar-inner">
        <Header search={site.header.search}>
          {showSearch && <Search slot="search" />}
          <ThemeSelect slot="theme" id="site-theme" />
          <ThemeSelect slot="theme-menu" id="site-theme-menu" />
        </Header>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer variant="page" />
    <script>
      import { enhanceScrollRegions } from '../../lib/scroll-regions';
      enhanceScrollRegions();
    </script>
  </body>
</html>
