---
// The shared footer: under the landing page and the gallery (variant `page`), and at the end of every docs page,
// after Starlight's edit link and pagination (variant `docs`, see overrides/Footer.astro).
import site from 'virtual:astro-project-site/config';

interface Props {
  /** `page`: full-width band under a page. `docs`: inside the docs content column. */
  variant?: 'page' | 'docs';
}
const { variant = 'page' } = Astro.props;
const version = site.version;
const year = new Date().getFullYear();
---

<footer class="site-footer" data-variant={variant}>
  <div class="inner">
    <div class="about">
      <a class="name" href="/">{site.name}</a>
      <p>{site.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={site.repo}>Source</a></li>
      </ul>
    </nav>
    <p class="meta">
      © {year} {site.name}{version && <> · v{version}</>}
      {site.footer?.note && <> · {site.footer.note}</>}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--site-border);
    background: var(--site-surface);
    color: var(--site-muted);
    font-size: 0.9375rem;
  }
  .inner {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding: calc(var(--site-space) * 2.5) var(--site-space);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--site-space) calc(var(--site-space) * 2);
    align-items: start;
  }
  .name {
    font-weight: 700;
    color: var(--site-text);
    text-decoration: none;
  }
  .about p {
    margin: 0.25rem 0 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  /* Comfortable targets (at least 24px, 44px on touch screens) without changing the line spacing much. */
  nav a,
  .name {
    display: inline-block;
    padding-block: 0.2rem;
  }
  a {
    color: inherit;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    color: var(--site-text);
    text-decoration: underline;
  }
  a:focus-visible {
    outline: 2px solid var(--site-focus);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .meta {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.8125rem;
  }
  @media (max-width: 40rem) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
  @media (pointer: coarse) {
    ul {
      gap: 0 0.5rem;
    }
    nav a,
    .name {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
    nav a {
      padding-inline: 0.5rem;
    }
    li:first-child a {
      margin-inline-start: -0.5rem;
    }
  }
  @media print {
    nav {
      display: none;
    }
    .site-footer {
      background: none;
    }
  }

  /* Inside the docs column: no band, aligned with the content. */
  [data-variant='docs'] {
    margin-top: 3rem;
    background: none;
    font-size: var(--sl-text-sm, 0.875rem);
  }
  [data-variant='docs'] .inner {
    padding: 1.5rem 0 0;
    grid-template-columns: 1fr;
  }
  [data-variant='docs'] ul {
    padding: 0;
  }
  [data-variant='docs'] li {
    margin: 0;
  }
</style>
