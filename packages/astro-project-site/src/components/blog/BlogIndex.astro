---
// The post list body: /blog/, /blog/2/, ... and each tag page /blog/tags/<tag>/. Renders inside BaseLayout.
// Replace it with `components.BlogIndex` (props: BlogIndexProps).
import '../../styles/components.css';
import site from 'virtual:astro-project-site/config';
import BlogCard from 'virtual:astro-project-site/components/BlogCard';
import type { BlogIndexProps } from '../../index';
import { rssPath } from '../../blog/options.mjs';
import { listUrl, tagsUrl } from '../../blog/posts.mjs';

type Props = BlogIndexProps;
const { posts, title, description, tag, tags, page } = Astro.props;
const blog = site.blog || { route: 'blog', rss: false, title: 'Blog' };
const feed = blog.rss ? rssPath(blog) : undefined;
---

<div class="site-container blog-index">
  <header class="page-header">
    {
      tag && (
        <p class="crumb">
          <a href={listUrl(blog.route)}>{blog.title}</a>
          <span aria-hidden="true"> / </span>
          <a href={tagsUrl(blog.route)}>Tags</a>
        </p>
      )
    }
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    {
      !tag && (tags.length > 0 || feed) && (
        <p class="links">
          {tags.length > 0 && <a href={tagsUrl(blog.route)}>All tags</a>}
          {
            feed && (
              <a href={feed} class="feed">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
                  <path fill="currentColor" d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6Zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7Zm2 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z" />
                </svg>
                RSS feed
              </a>
            )
          }
        </p>
      )
    }
  </header>

  {
    posts.length > 0 ? (
      <ol class="posts">
        {posts.map((post) => (
          <li>
            <BlogCard post={post} headingLevel={2} />
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">
        No posts yet. Add a Markdown or MDX file to <code>src/content/blog/</code>.
      </p>
    )
  }

  {
    page.last > 1 && (
      <nav class="pagination" aria-label="Pages">
        {page.prev ? (
          <a href={page.prev} rel="prev">
            <span aria-hidden="true">←</span> Newer posts
          </a>
        ) : (
          <span />
        )}
        <span class="count">
          Page {page.current} of {page.last}
        </span>
        {page.next ? (
          <a href={page.next} rel="next">
            Older posts <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</div>

<style>
  .blog-index {
    max-width: 52rem;
    padding-block: calc(var(--site-space) * 3) calc(var(--site-space) * 4);
  }
  .page-header {
    margin-bottom: calc(var(--site-space) * 2.5);
    padding-bottom: calc(var(--site-space) * 1.5);
    border-bottom: 1px solid var(--site-border);
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .lead {
    max-width: 40rem;
    margin: 0;
    color: var(--site-muted);
    font-size: 1.125rem;
  }
  .crumb {
    margin: 0 0 0.5rem;
    color: var(--site-muted);
    font-size: 0.9375rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1rem 0 0;
    font-size: 0.9375rem;
  }
  .feed {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts > li + li {
    margin-top: calc(var(--site-space) * 2);
    padding-top: calc(var(--site-space) * 2);
    border-top: 1px solid var(--site-border);
  }
  .empty {
    color: var(--site-muted);
  }
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: calc(var(--site-space) * 3);
    padding-top: calc(var(--site-space) * 1.5);
    border-top: 1px solid var(--site-border);
    font-weight: 600;
  }
  .pagination a:last-child {
    justify-self: end;
  }
  .count {
    color: var(--site-muted);
    font-size: 0.875rem;
    font-weight: 400;
  }
  @media (pointer: coarse) {
    .links a,
    .crumb a,
    .pagination a {
      display: inline-flex;
      align-items: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
    }
  }
</style>
