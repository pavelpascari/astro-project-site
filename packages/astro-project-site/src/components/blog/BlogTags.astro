---
// The tag index body (/blog/tags/): every tag with its post count. Renders inside BaseLayout.
import '../../styles/components.css';
import site from 'virtual:astro-project-site/config';
import { listUrl, tagUrl } from '../../blog/posts.mjs';
import { t as label } from '../../lib/labels';

interface Props {
  tags: { tag: string; slug: string; count: number }[];
  title: string;
}
const { tags, title } = Astro.props;
const blog = site.blog || { route: 'blog', title: label('blog') };
---

<div class="site-container blog-tags">
  <header class="page-header">
    <p class="crumb"><a href={listUrl(blog.route)}>{blog.title}</a></p>
    <h1>{title}</h1>
  </header>
  <ul>
    {
      tags.map((t) => (
        <li>
          <a href={tagUrl(blog.route, t.tag)}>
            <span class="name">{t.tag}</span>
            <span class="count">
              {label('postCount', { n: t.count })}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .blog-tags {
    max-width: 52rem;
    padding-block: calc(var(--site-space) * 3) calc(var(--site-space) * 4);
  }
  .page-header {
    margin-bottom: calc(var(--site-space) * 2);
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .crumb {
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
  }
  ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }
  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-sm);
    text-decoration: none;
  }
  a:hover {
    border-color: var(--site-accent);
  }
  .name {
    font-weight: 600;
  }
  .count {
    color: var(--site-muted);
    font-size: 0.875rem;
  }
  @media (pointer: coarse) {
    .crumb a {
      display: inline-flex;
      align-items: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
    }
  }
</style>
