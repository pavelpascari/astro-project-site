---
// Injected at /gallery/ unless `gallery: false` or the project has its own src/pages/gallery.astro.
import site from 'virtual:astro-project-site/config';
import BaseLayout from '../components/layouts/BaseLayout.astro';
import { Gallery } from 'virtual:astro-project-site/components';
import { galleryItems } from '../lib/gallery';

const items = await galleryItems();
const options = site.gallery || {};
const title = options.title ?? 'Gallery';
const description = options.description ?? 'Demos, examples and tools, running live.';
---

<BaseLayout title={title} description={description}>
  <Gallery items={items} title={title} description={description} />
</BaseLayout>
