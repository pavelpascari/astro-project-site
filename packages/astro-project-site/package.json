{
  "name": "astro-project-site",
  "version": "0.1.0-beta.7",
  "description": "An Astro integration for open-source project sites: landing page, Starlight docs that mount your markdown folder, live examples, a gallery, static apps served as they are, Cloudflare deploys.",
  "license": "MIT",
  "author": {
    "name": "Pavel Pascari",
    "url": "https://github.com/pavelpascari"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavelpascari/astro-project-site.git",
    "directory": "packages/astro-project-site"
  },
  "homepage": "https://github.com/pavelpascari/astro-project-site/tree/main/packages/astro-project-site#readme",
  "bugs": {
    "url": "https://github.com/pavelpascari/astro-project-site/issues"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "starlight",
    "documentation",
    "project-site",
    "astro",
    "cloudflare-workers",
    "docs-site"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./components": "./src/components/index.ts",
    "./live": "./src/components/live/Live.astro",
    "./margin-note": "./src/components/blog/MarginNote.astro",
    "./content": "./src/content.ts",
    "./config": "./src/config.ts",
    "./theme.css": "./src/styles/theme.css",
    "./virtual": {
      "types": "./src/virtual.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "project-site": "./bin/project-site.mjs"
  },
  "files": [
    "bin",
    "src",
    "starter",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json",
    "prepack": "node scripts/pack-starter.mjs",
    "postpack": "node scripts/pack-starter.mjs --clean"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.7",
    "mermaid": "^12.3.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@expressive-code/core": "^0.44.4",
    "@expressive-code/plugin-collapsible-sections": "^0.44.4",
    "@expressive-code/plugin-line-numbers": "^0.44.4",
    "gemoji": "^8.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.1.0",
    "katex": "^0.19.1",
    "starlight-links-validator": "^0.27.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  }
}
